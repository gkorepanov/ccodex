# Clean machine with the latest Codex and a packed CCodex build (`ccodex setup` from the tarball).
FROM docker.io/library/node:22-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends tmux sqlite3 && rm -rf /var/lib/apt/lists/*
USER node
ENV HOME=/home/node NPM_CONFIG_PREFIX=/home/node/.npm-global
ENV PATH=/home/node/.ccodex/bin:/home/node/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ARG CODEX_VERSION=latest
RUN npm install -g "@openai/codex@${CODEX_VERSION}" --no-audit --no-fund && codex --version
ARG CCODEX_VERSION
COPY --chown=node:node ccodex.tgz /tmp/ccodex.tgz
RUN CCODEX_PACKAGE_SPEC=/tmp/ccodex.tgz npx --yes --package /tmp/ccodex.tgz ccodex setup --version "${CCODEX_VERSION}" \
 && mkdir -p /home/node/.claude /home/node/.codex /home/node/work \
 && printf '%s\n' 'idle_timeout_seconds = 3600' 'log_level = "debug"' >> /home/node/.ccodex/config.toml
WORKDIR /home/node/work
