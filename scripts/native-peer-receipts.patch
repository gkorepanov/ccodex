+def peer_event(r):
+    """Only native peer user/absorbed-input records, never arbitrary text copies."""
+    if r.get("type") == "user" and (r.get("origin") or {}).get("kind") == "peer":
+        return r.get("origin"), r.get("message", {}).get("content", ""), r.get("uuid")
+    a = r.get("attachment") or {}
+    if r.get("type") == "attachment" and a.get("type") == "queued_command" and (a.get("origin") or {}).get("kind") == "peer":
+        return a["origin"], a.get("prompt", ""), a.get("source_uuid") or r.get("uuid")
+    return None
+
+
+def peer_group(job):
+    root = job.get("steer_of") or job["job_id"]
+    return {p.stem for p in job_files() if (lambda j: j.get("session_id") == job["session_id"]
+            and j.get("transport") == "native_peer" and j.get("expected_native_pid") == job.get("expected_native_pid")
+            and (p.stem == root or j.get("steer_of") == root) and j.get("submission_started_at") is not None)(load_json(p))}
+
+
+def is_tool_result(record):
+    blocks = (record.get("message") or {}).get("content")
+    return record.get("type") == "user" and (record.get("toolUseResult") is not None
+            or isinstance(blocks, list) and any(isinstance(b, dict) and b.get("type") == "tool_result" for b in blocks))
+
+
+def peer_receipt(records, job, allowed_job_ids=None):
+    """Read-only correlation on the current native branch, including preserved compactions.
+
+    A compact summary is transcript bookkeeping, not another human prompt. Re-link
+    the native preserved UUIDs before using the pinned SDK's branch selection.
+    Never use summary wording, idle state or socket success as receipt evidence.
+    """
+    from claude_agent_sdk._internal.sessions import _build_conversation_chain
+    marker = "[Codex bridge request " + job["job_id"] + "]"
+    entries = {r["uuid"]: r for r in records if isinstance(r.get("uuid"), str)
+               and r.get("type") in ("user", "assistant", "system", "attachment", "progress")}
+    delivered = [r for r in entries.values() if peer_event(r)
+                 and not r.get("isSidechain") and not r.get("teamName")
+                 and marker in text_content(peer_event(r)[1], 100_000)]
+    if len(delivered) != 1:
+        return {"delivery_found": False}  # Missing window or ambiguous evidence: fail closed.
+    delivery = delivered[0]
+    native_uuid = peer_event(delivery)[2]
+    if job.get("delivery_message_uuid") not in (None, native_uuid):
+        return {"delivery_found": False, "error": "Native delivery identity changed; inspect original history"}
+    for r in list(entries.values()):
+        if r.get("type") != "system" or r.get("subtype") != "compact_boundary":
+            continue
+        meta = r.get("compactMetadata") or {}
+        kept, segment = meta.get("preservedMessages"), meta.get("preservedSegment")
+        if kept:
+            uuids = kept.get("uuids", [])
+            if not uuids or kept.get("anchorUuid") not in entries or any(u not in entries for u in uuids):
+                continue
+            parent = kept["anchorUuid"]
+            for uid in uuids:
+                entries[uid] = {**entries[uid], "parentUuid": parent}
+                parent = uid
+            head, tail, anchor = uuids[0], uuids[-1], kept["anchorUuid"]
+        elif segment and all(segment.get(k) in entries for k in ("headUuid", "tailUuid", "anchorUuid")):
+            head, tail, anchor = (segment[k] for k in ("headUuid", "tailUuid", "anchorUuid"))
+            entries[head] = {**entries[head], "parentUuid": anchor}
+        else:
+            continue
+        for uid, candidate in list(entries.items()):
+            if candidate.get("parentUuid") == anchor and uid != head:
+                entries[uid] = {**candidate, "parentUuid": tail}
+    chain = _build_conversation_chain(list(entries.values()))
+    prompt_id = delivery.get("promptId")
+    delivery_parent = entries.get(delivery.get("parentUuid"), {})
+    if not prompt_id and delivery.get("type") == "attachment" and is_tool_result(delivery_parent):
+        prompt_id = delivery_parent.get("promptId")
+    receipt = {"delivery_found": True, "delivery_message_uuid": native_uuid, "delivery_record_uuid": delivery["uuid"],
+               "delivery_prompt_id": delivery.get("promptId"), "terminal": False}
+    seen, answer, terminal_id = False, [], None
+    for r in chain:
+        if r["uuid"] == delivery["uuid"]:
+            seen = True
+            continue
+        if not seen:
+            continue
+        msg = r.get("message") or {}
+        blocks = msg.get("content", [])
+        # One API message may persist thinking and text as separate end_turn records.
+        if receipt["terminal"] and (r.get("type") in ("user", "assistant") or peer_event(r)) and not (
+                r.get("type") == "assistant" and terminal_id is not None and msg.get("id") == terminal_id):
+            break
+        event = peer_event(r)
+        if event:
+            linked = event[0].get("from") == "bridge:codex" and any(
+                "[Codex bridge request " + key + "]" in text_content(event[1], 100_000) for key in allowed_job_ids or [])
+            if linked:
+                continue
+            receipt["error"] = "Another prompt arrived before the correlated reply; inspect native history"
+            break
+        attachment = r.get("attachment") or {}
+        if r.get("type") == "attachment" and attachment.get("type") == "queued_command" and attachment.get("prompt") and attachment.get("commandMode") != "task-notification":
+            parent = entries.get(r.get("parentUuid"), {})
+            # Claude can absorb input entered in the App immediately after a tool
+            # result. The native prompt ID on that result proves the turn is shared.
+            if (prompt_id and parent.get("promptId") == prompt_id and is_tool_result(parent)
+                    and not r.get("isSidechain") and not r.get("teamName")
+                    and (attachment.get("origin") or {}).get("kind") == "human"
+                    and attachment.get("commandMode") == "prompt" and attachment.get("humanTurn") is True
+                    and attachment.get("source_uuid") and attachment.get("delivery_id")):
+                receipt["local_input_absorbed"] = True
+                continue
+            receipt["error"] = "Another prompt arrived before the correlated reply; inspect native history"
+            break
+        if r.get("type") == "user":
+            if r.get("isCompactSummary") is True or is_tool_result(r):
+                continue
+            # Metadata without a conversational origin is not a user submission.
+            if r.get("isMeta") and (r.get("origin") or {}).get("kind") not in ("peer", "coordinator"):
+                continue
+            if isinstance(blocks, str) or isinstance(blocks, list) and any(
+                    isinstance(b, dict) and b.get("type") == "text" for b in blocks):
+                receipt["error"] = "Another prompt arrived before the correlated reply; inspect native history"
+                break
+        elif r.get("type") == "assistant":
+            plain = text_content([b for b in blocks if isinstance(b, dict) and b.get("type") == "text"], 12000) if isinstance(blocks, list) else str(blocks)
+            if plain:
+                answer.append(plain)
+            if msg.get("stop_reason") == "end_turn":
+                receipt.update(terminal=True, terminal_message_uuid=r["uuid"])
+                terminal_id = msg.get("id")
+    receipt["result"] = "\n".join(answer)
+    if receipt["terminal"] and not answer:
+        receipt["terminal"] = False  # A thinking block alone is not a usable reply.
+    return receipt
+
+
+def apply_peer_receipt(j, receipt):
+    if receipt.get("delivery_found"):
+        j.setdefault("delivery_verified_at", now())
+        j.update(delivery="verified_in_transcript", delivery_message_uuid=receipt["delivery_message_uuid"], delivery_record_uuid=receipt.get("delivery_record_uuid"),
+                 delivery_prompt_id=receipt.get("delivery_prompt_id"), partial_result=receipt.get("result", "")[-12000:])
+    if receipt.get("error"):
+        j.update(status="unknown", error=receipt["error"])
+    elif receipt.get("terminal"):
+        if j.get("error"):
+            j.setdefault("prior_receipt_error", j.pop("error"))
+        j.update(status="completed", result=receipt["result"], resumed_session_id=j["session_id"],
+                 terminal_message_uuid=receipt["terminal_message_uuid"], result_subtype="native_peer_end_turn")
+        if receipt.get("local_input_absorbed"):
+            j["result_subtype"] = "native_peer_end_turn_with_local_input"
+
+
+def reconcile_peer_job(job_id: str) -> dict:
+    """Repair a durable receipt from native history only. No send/worker/model call."""
+    path = job_path(job_id)
+    j = load_json(path)
+    if j.get("transport") != "native_peer" or not j.get("submission_started_at"):
+        raise ValueError("Only an already submitted native peer receipt can be reconciled")
+    if j.get("status") == "completed":
+        return claude_job_status(job_id)  # Keep terminal evidence after later rollbacks/compactions.
+    with (STATE / (j["session_id"] + ".lock")).open("a") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        j = load_json(path)
+        # Peer workers poll and publish their terminal receipt outside the dispatch lock.
+        # Do not write while the original worker can still update this receipt.
+        if j.get("status") == "completed" or (not j.get("finished_at")
+                and alive(j.get("worker_pid"), j.get("worker_created"))):
+            return claude_job_status(job_id)
+        records, partial = tail_records(transcript_path(info(j["session_id"], j.get("directory"))), 8_000_000)
+        receipt = peer_receipt(records, j, peer_group(j))
+        apply_peer_receipt(j, receipt)
+        j.update(receipt_reconciled_at=now(), receipt_window_is_partial=partial)
+        write_json(path, j)
+    return claude_job_status(job_id)
+
+
+def wait_peer_predecessors(job):
+    """Preserve root/correction send order even when worker scheduling differs."""
+    root = job.get("steer_of")
+    if not root:
+        return
+    deadline = now() + 20
+    while True:
+        ready = True
+        parent = claude_job_status(root)
+        if parent["status"] not in ("queued", "running"):
+            raise ValueError("STEER_TURN_ENDED: original shared turn is not active; correction not sent")
+        for p in job_files():
+            other = load_json(p)
+            predecessor = p.stem == root or other.get("steer_of") == root and other.get("created_at", float("inf")) < job["created_at"]
+            if not predecessor or other.get("session_id") != job["session_id"]:
+                continue
+            observed = claude_job_status(p.stem)["status"]
+            if observed in ("unknown", "failed"):
+                raise ValueError("Previous shared delivery is unknown; correction not sent")
+            if observed != "failed_before_send" and not other.get("socket_written_at"):
+                ready = False
+        if ready:
+            return
+        if now() >= deadline:
+            raise ValueError("Previous input dispatch not acknowledged; correction not sent")
+        time.sleep(0.02)
+
