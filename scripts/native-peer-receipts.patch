+    def test_corrections_wait_for_root_and_prior_correction_dispatch(self):
+        root, prior, current = "1"*32, "2"*32, "3"*32
+        common = {"session_id": self.sid, "status": "running", "worker_pid": os.getpid(), "worker_created": bridge.psutil.Process().create_time()}
+        bridge.write_json(bridge.job_path(root), {**common, "job_id": root, "created_at": bridge.now()})
+        bridge.write_json(bridge.job_path(prior), {**common, "job_id": prior, "steer_of": root, "created_at": bridge.now()})
+        job = {**common, "job_id": current, "steer_of": root, "created_at": bridge.now()}
+        waits = []
+        def advance(_):
+            key = root if not waits else prior
+            value = bridge.load_json(bridge.job_path(key));value["socket_written_at"] = bridge.now();bridge.write_json(bridge.job_path(key), value)
+            waits.append(key)
+        with patch.object(bridge.time, "sleep", side_effect=advance):
+            bridge.wait_peer_predecessors(job)
+        self.assertEqual(waits, [root, prior])
