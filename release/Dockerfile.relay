# syntax=docker/dockerfile:1.7
FROM rust:1.95-bullseye AS build

ARG TARGET
# Keep the glibc 2.31 baseline reproducible when Bullseye packages leave mirrors.
RUN printf '%s\n' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20260830T000000Z bullseye main' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/20260830T000000Z bullseye-security main' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20260830T000000Z bullseye-updates main' \
      > /etc/apt/sources.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends clang cmake perl pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add "$TARGET"

WORKDIR /work
COPY relay/Cargo.toml relay/Cargo.lock ./relay/
COPY relay/src ./relay/src
COPY relay/vendor ./relay/vendor
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/work/relay/target \
    cargo build --locked --manifest-path relay/Cargo.toml --release --target "$TARGET" \
    && install -m 755 "relay/target/$TARGET/release/codex-hybrid-remote-relay" /tmp/ccodex-relay

FROM scratch
COPY --from=build /tmp/ccodex-relay /ccodex-relay
